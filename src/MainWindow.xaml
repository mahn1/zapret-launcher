<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Launcher" Width="900" Height="560" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#0B0D12" Foreground="#E8EBF2"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Sub" Color="#8B93A7"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2EE6A8" Offset="0"/>
      <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#11151E"/>
      <Setter Property="BorderBrush" Value="#1C2232"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Навигация -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Foreground" Value="#6F7890"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Border x:Name="hl" CornerRadius="12" Background="#1A1F2B" Opacity="0"/>
              <Border x:Name="sel" CornerRadius="12" Background="#182030" Opacity="0"/>
              <Border x:Name="bar" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"
                      Background="{StaticResource AccentGrad}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform>
              </Border>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#E8EBF2"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Кнопки -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#E8EBF2"/>
      <Setter Property="Background" Value="#181D28"/>
      <Setter Property="BorderBrush" Value="#262D3D"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
              <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
              <Border x:Name="hl" CornerRadius="10" Background="#FFFFFF" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.96" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.96" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource AccentGrad}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#06110D"/>
    </Style>
    <Style x:Key="Cap" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="#8B93A7"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bg" Background="{TemplateBinding Background}" Opacity="0" CornerRadius="8"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Скроллбар -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Background="#2A3142"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Список стратегий -->
    <Style x:Key="StratItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#AEB6C7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,2" Background="Transparent">
              <Border x:Name="hl" CornerRadius="10" Background="#181D28" Opacity="0"/>
              <Border x:Name="sel" CornerRadius="10" BorderThickness="1" BorderBrush="#552EE6A8" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#302EE6A8" Offset="0"/>
                    <GradientStop Color="#083B82F6" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ContentPresenter Margin="14,9"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Box" TargetType="TextBox">
      <Setter Property="Background" Value="#0E1118"/>
      <Setter Property="Foreground" Value="#B9C0CF"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="SelectionBrush" Value="#2EE6A8"/>
      <Setter Property="CaretBrush" Value="#2EE6A8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="#1C2232" BorderThickness="1" Padding="14,10,8,10">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Prog" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="#1A1F2B"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource AccentGrad}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- бумажный самолётик Telegram, 24x24 -->
    <Geometry x:Key="TgPlane">F0 M21.4,3.6 L2.9,10.8 C1.9,11.2 1.9,11.9 2.7,12.1 L7.4,13.6 L9.2,19.2 C9.4,19.8 9.6,20 10.1,20 C10.6,20 10.8,19.8 11.1,19.5 L13.4,17.3 L18.1,20.8 C19,21.3 19.6,21 19.8,20 L22.9,5.2 C23.2,3.9 22.4,3.3 21.4,3.6 Z M8.6,13.2 L18.7,6.8 C19.2,6.5 19.6,6.7 19.2,7 L10.6,14.8 L10.3,18.4 Z</Geometry>
    <LinearGradientBrush x:Key="TgGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#37BBFE" Offset="0"/>
      <GradientStop Color="#007DBB" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Переключатель с плавным бегунком -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EBF2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,7"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel x:Name="root" Background="Transparent">
              <Grid DockPanel.Dock="Left" Width="40" Height="22" Margin="0,0,14,0" VerticalAlignment="Center">
                <Border CornerRadius="11" Background="#232A39"/>
                <Border x:Name="on" CornerRadius="11" Background="{StaticResource AccentGrad}" Opacity="0"/>
                <Ellipse x:Name="knob" Width="16" Height="16" Fill="#E8EBF2" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="#E8EBF2"/>
      <Setter Property="CaretBrush" Value="#2EE6A8"/>
      <Setter Property="SelectionBrush" Value="#2EE6A8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" CornerRadius="10" Background="#0E1118" BorderBrush="#262D3D" BorderThickness="1" Padding="10,8">
              <Grid>
                <TextBlock x:Name="ph" Text="example.com или ссылка на сайт" Foreground="#5B6375" Margin="2,0,0,0"
                           Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#2EE6A8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="#151A24"/>
      <Setter Property="BorderBrush" Value="#222838"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="5,0"/>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="#151A24"/>
      <Setter Property="BorderBrush" Value="#222838"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#1A1F2C" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <!-- Боковая панель -->
      <Border Background="#0E1118" BorderBrush="#161B26" BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="72">
            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentGrad}">
              <Viewbox Width="22" Height="22">
                <Canvas Width="24" Height="24">
                  <Path Data="M12,1.5 L21,5 V11.5 C21,17 17.2,20.8 12,22.5 C6.8,20.8 3,17 3,11.5 V5 Z" Fill="#06110D" Opacity="0.88"/>
                  <Path Data="M13.2,5.5 L8,13 H11.6 L10.6,18.5 L16,10.8 H12.4 Z" Fill="#2EE6A8"/>
                </Canvas>
              </Viewbox>
            </Border>
          </Grid>
          <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
            <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Content="&#xE80F;" ToolTip="Главная" IsChecked="True"/>
            <RadioButton x:Name="NavService" Style="{StaticResource Nav}" Content="&#xE713;" ToolTip="Служба"/>
            <Grid>
              <RadioButton x:Name="NavUpdate" Style="{StaticResource Nav}" Content="&#xE896;" ToolTip="Обновления"/>
              <Ellipse x:Name="UpdDot" Width="8" Height="8" Fill="#2EE6A8" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,12,10,0" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <RadioButton x:Name="NavTg" Style="{StaticResource Nav}" ToolTip="Telegram: прокси">
              <Viewbox Width="20" Height="20">
                <Path Data="{StaticResource TgPlane}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </Viewbox>
            </RadioButton>
            <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" Content="&#xE8A5;" ToolTip="Журнал"/>
          </StackPanel>
          <Grid/>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Margin="24,0,8,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnMin" Style="{StaticResource Cap}" Content="&#xE921;" Background="#1F2533"/>
            <Button x:Name="BtnClose" Style="{StaticResource Cap}" Content="&#xE8BB;" Background="#E5484D"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Zapret Launcher" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Chip}"><TextBlock x:Name="ChipVer" Text="—" FontSize="11" Foreground="{StaticResource Sub}"/></Border>
            <Border Style="{StaticResource Chip}">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ChipAdminDot" Width="6" Height="6" Fill="#F5B14C" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ChipAdmin" Text="без прав" FontSize="11" Foreground="{StaticResource Sub}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="24,4,24,24">
          <!-- ГЛАВНАЯ -->
          <Grid x:Name="PageHome">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.15*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" ClipToBounds="True">
              <Grid>
                <StackPanel Margin="24,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBlock Text="Обход блокировок" Style="{StaticResource H1}"/>
                  <TextBlock Text="Discord · YouTube · winws" Foreground="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="UptimeBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,24,0" Opacity="0">
                  <TextBlock Text="В РАБОТЕ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Sub}" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="Uptime" Text="00:00:00" FontFamily="Cascadia Mono, Consolas" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
                <Grid x:Name="PowerBtn" Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="0,0,0,46" Cursor="Hand" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                  <Ellipse x:Name="Glow" Width="250" Height="250" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.Fill>
                      <RadialGradientBrush>
                        <GradientStop Color="#702EE6A8" Offset="0.5"/>
                        <GradientStop Color="#283B82F6" Offset="0.72"/>
                        <GradientStop Color="#003B82F6" Offset="1"/>
                      </RadialGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Width="192" Height="192" Stroke="#1C2231" StrokeThickness="2"/>
                  <Ellipse x:Name="Spinner" Width="192" Height="192" StrokeThickness="3" StrokeDashArray="18 46"
                           StrokeDashCap="Round" Opacity="0" RenderTransformOrigin="0.5,0.5" Stroke="{StaticResource AccentGrad}"/>
                  <Ellipse x:Name="Core" Width="166" Height="166">
                    <Ellipse.Effect>
                      <DropShadowEffect BlurRadius="34" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
                    </Ellipse.Effect>
                  </Ellipse>
                  <Ellipse Width="166" Height="166" IsHitTestVisible="False">
                    <Ellipse.Fill>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#18FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                      </LinearGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <TextBlock x:Name="PowerGlyph" Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="56"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
                  <TextBlock x:Name="StateText" Text="Выключено" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="StateSub" Text="Нажмите, чтобы запустить" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                  <StackPanel x:Name="Pings" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Opacity="0">
                    <Border Style="{StaticResource Pill}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotYt" Width="8" Height="8" Fill="#8B93A7" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        <TextBlock Text="YouTube" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MsYt" Text="…" Foreground="{StaticResource Sub}" Margin="8,0,0,0" FontFamily="Cascadia Mono, Consolas"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotDc" Width="8" Height="8" Fill="#8B93A7" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        <TextBlock Text="Discord" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MsDc" Text="…" Foreground="{StaticResource Sub}" Margin="8,0,0,0" FontFamily="Cascadia Mono, Consolas"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <DockPanel Margin="14,16,10,14">
                <DockPanel DockPanel.Dock="Top" Margin="8,0,4,10">
                  <Button x:Name="BtnPick" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="12,5" Margin="0" FontSize="12"
                          Content="Подобрать" ToolTip="Перебрать все стратегии и выбрать лучшую для YouTube и Discord"/>
                  <TextBlock x:Name="StratCount" DockPanel.Dock="Right" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Text="Стратегия" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="StratList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource StratItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              </DockPanel>
            </Border>
            <Border x:Name="NotFound" Grid.ColumnSpan="3" Style="{StaticResource Card}" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="42" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                <TextBlock Text="Папка zapret не найдена" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Sub}" Margin="0,0,0,18"
                           Text="Положите лаунчер в папку zapret-discord-youtube (рядом с service.bat), укажите её вручную или скачайте последний релиз с GitHub."/>
                <WrapPanel HorizontalAlignment="Center">
                  <Button x:Name="BtnPickDir" Style="{StaticResource Btn}" Content="Указать папку"/>
                  <Button x:Name="BtnFirstDownload" Style="{StaticResource Accent}" Content="Скачать последний релиз"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- СЛУЖБА -->
          <ScrollViewer x:Name="PageService" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Служба Windows" Style="{StaticResource H1}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Sub}" Margin="0,4,0,18" MaxWidth="620" HorizontalAlignment="Left"
                       Text="Служба запускает zapret вместе с Windows, без открытого лаунчера. Установка и удаление выполняются оригинальным service.bat."/>
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" Margin="0,0,16,0">
                  <Ellipse x:Name="SvcHalo" Fill="#8B93A7" Opacity="0.15"/>
                  <Ellipse x:Name="SvcDot" Width="12" Height="12" Fill="#8B93A7"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="SvcState" Text="Не установлена" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SvcStrategy" Text="—" Foreground="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <WrapPanel>
              <Button x:Name="BtnSvcInstall" Style="{StaticResource Accent}" Content="Установить службу"/>
              <Button x:Name="BtnSvcRemove" Style="{StaticResource Btn}" Content="Удалить службу"/>
              <Button x:Name="BtnSvcMenu" Style="{StaticResource Btn}" Content="Открыть меню service.bat"/>
            </WrapPanel>
            <TextBlock x:Name="SvcHint" Foreground="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Запуск и сторож" Style="{StaticResource H2}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}" Padding="20,12">
              <StackPanel>
                <CheckBox x:Name="TglAutostart" Style="{StaticResource Toggle}" Content="Запускать вместе с Windows — сразу в трей, без запроса UAC"/>
                <CheckBox x:Name="TglAutoOn" Style="{StaticResource Toggle}" Content="Включать обход при запуске лаунчера (последняя стратегия)"/>
                <CheckBox x:Name="TglWatch" Style="{StaticResource Toggle}" Content="Сторож: перезапускать winws при падении и предупреждать, если YouTube или Discord перестали отвечать"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Свои сайты" Style="{StaticResource H2}" Margin="0,24,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Sub}" Margin="0,0,0,10"
                       Text="Сайты «в обходе» идут через zapret, «исключения» — напрямую. Поддомены учитываются автоматически."/>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,8">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="BtnDomExclude" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="В исключения" Margin="10,0,0,0"/>
                  <Button x:Name="BtnDomAdd" DockPanel.Dock="Right" Style="{StaticResource Accent}" Content="В обход" Margin="10,0,0,0"/>
                  <TextBox x:Name="DomInput" Style="{StaticResource Input}"/>
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                  <TextBlock Text="Быстро:" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="2,0,10,8"/>
                  <Button x:Name="BtnPresetRoblox" Style="{StaticResource Btn}" Padding="12,5" FontSize="12" Margin="0,0,8,8"
                          Content="Roblox — картинки" ToolTip="roblox.com, rbxcdn.com, robloxlabs.com"/>
                  <Button x:Name="BtnPresetPhoton" Style="{StaticResource Btn}" Padding="12,5" FontSize="12" Margin="0,0,8,8"
                          Content="Photon — онлайн в играх" ToolTip="photonengine.com, photonengine.io, exitgames.com + Game Filter (TCP и UDP)"/>
                </WrapPanel>
                <Grid Height="150" Margin="0,12,0,0">
                  <ListBox x:Name="DomList" Background="Transparent" BorderThickness="0" Padding="0"
                           ItemContainerStyle="{StaticResource StratItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Foreground="#8B93A7"/>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="DomEmpty" Text="Своих сайтов пока нет" Foreground="{StaticResource Sub}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <DockPanel Margin="0,10,0,0">
                  <Button x:Name="BtnDomRemove" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Удалить" IsEnabled="False" Margin="0"/>
                  <TextBlock Foreground="{StaticResource Sub}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                             Text="Изменения применяются перезапуском обхода — лаунчер сделает это сам."/>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          </ScrollViewer>

          <!-- ОБНОВЛЕНИЯ -->
          <DockPanel x:Name="PageUpdate" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Обновления" Style="{StaticResource H1}"/>
              <TextBlock Text="Источник: github.com/Flowseal/zapret-discord-youtube · только по кнопке" Foreground="{StaticResource Sub}" Margin="0,4,0,16"/>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="18,14">
                  <StackPanel>
                    <TextBlock Text="Установлено" Foreground="{StaticResource Sub}"/>
                    <TextBlock x:Name="VerLocal" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                  <StackPanel>
                    <TextBlock x:Name="VerRemoteLabel" Text="Последний релиз" Foreground="{StaticResource Sub}"/>
                    <TextBlock x:Name="VerRemote" Text="не проверено" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
              <WrapPanel>
                <Button x:Name="BtnCheck" Style="{StaticResource Btn}" Content="Проверить"/>
                <Button x:Name="BtnUpdate" Style="{StaticResource Accent}" Content="Скачать и установить" IsEnabled="False"/>
                <Button x:Name="BtnReleasePage" Style="{StaticResource Btn}" Content="Страница релиза"/>
              </WrapPanel>
              <ProgressBar x:Name="UpdProgress" Style="{StaticResource Prog}" Maximum="100" Margin="0,2,0,14" Visibility="Collapsed"/>
              <TextBlock Text="Что нового" FontWeight="SemiBold" Margin="0,0,0,8"/>
            </StackPanel>
            <TextBox x:Name="Changelog" Style="{StaticResource Box}" Text="Нажмите «Проверить», чтобы получить список изменений."/>
          </DockPanel>

          <!-- TELEGRAM -->
          <DockPanel x:Name="PageTg" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Telegram" Style="{StaticResource H1}"/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Sub}" Margin="0,4,0,16" MaxWidth="640" HorizontalAlignment="Left"
                         Text="Ищет рабочие MTProto-прокси в открытых списках и подключает их к Telegram Desktop в один клик — Telegram сам спросит подтверждение. Переписка остаётся зашифрованной, владелец прокси видит только ваш IP."/>
              <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="44" Height="44" Margin="0,0,16,0">
                    <Ellipse Fill="{StaticResource TgGrad}"/>
                    <Viewbox Width="22" Height="22" Margin="0,1,2,0">
                      <Path Data="{StaticResource TgPlane}" Fill="White"/>
                    </Viewbox>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TgState" Text="—" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TgSub" Text="—" Foreground="{StaticResource Sub}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </Border>
              <WrapPanel>
                <Button x:Name="BtnTgFind" Style="{StaticResource Accent}" Content="Найти прокси"/>
                <Button x:Name="BtnTgConnect" Style="{StaticResource Btn}" Content="Подключить в Telegram" IsEnabled="False"/>
                <Button x:Name="BtnTgCopy" Style="{StaticResource Btn}" Content="Скопировать ссылку" IsEnabled="False"/>
              </WrapPanel>
              <ProgressBar x:Name="TgProgress" Style="{StaticResource Prog}" Margin="0,2,0,12" Visibility="Collapsed"/>
              <DockPanel Margin="2,0,2,8">
                <TextBlock x:Name="TgCount" DockPanel.Dock="Right" Foreground="{StaticResource Sub}"/>
                <TextBlock Text="Лучшие по отклику" FontWeight="SemiBold"/>
              </DockPanel>
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="10,8,6,8">
              <Grid>
                <ListBox x:Name="TgList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource StratItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MsText}" FontFamily="Cascadia Mono, Consolas" Foreground="#2EE6A8"/>
                        <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TgEmpty" Text="Нажмите «Найти прокси»" Foreground="{StaticResource Sub}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </Border>
          </DockPanel>

          <!-- ЖУРНАЛ -->
          <DockPanel x:Name="PageLog" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnLogFolder" Style="{StaticResource Btn}" Content="Папка zapret" Margin="0,0,10,0"/>
                <Button x:Name="BtnLogClear" Style="{StaticResource Btn}" Content="Очистить" Margin="0"/>
              </StackPanel>
              <TextBlock Text="Журнал" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="LogBox" Style="{StaticResource Box}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
          </DockPanel>
        </Grid>

        <!-- Уведомление -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40"
                CornerRadius="12" Background="#1B2130" BorderBrush="#2A3245" BorderThickness="1" Padding="16,10"
                Opacity="0" IsHitTestVisible="False">
          <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5"/></Border.Effect>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="#2EE6A8" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ToastText" MaxWidth="520" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
